{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar extensión",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--new-window"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "Ejecutar extensión (sin compilar)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--new-window"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    },
    {
      "name": "Diagnosticar cierre (aislada)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--new-window",
        "--disable-extensions",
        "--disable-gpu"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
