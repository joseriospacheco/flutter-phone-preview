{
  "name": "flutter-phone-preview",
  "displayName": "Flutter Phone Preview",
  "description": "Ejecuta tu app Flutter Web dentro de VS Code con un marco de teléfono (iPhone/Android).",
  "version": "0.3.3",
  "icon": "images/icon.png",
  "publisher": "1108762718",
  "repository": {
    "type": "git",
    "url": "https://github.com/joseriospacheco/flutter-phone-preview.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:flutterPhonePreview.start",
    "onCommand:flutterPhonePreview.stop",
    "onCommand:flutterPhonePreview.hotReload",
    "onCommand:flutterPhonePreview.hotRestart"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterPhonePreview.start",
        "title": "Flutter: Iniciar vista previa en teléfono"
      },
      {
        "command": "flutterPhonePreview.stop",
        "title": "Flutter: Detener vista previa en teléfono"
      },
      {
        "command": "flutterPhonePreview.hotReload",
        "title": "Flutter: Hot reload (vista previa en teléfono)"
      },
      {
        "command": "flutterPhonePreview.hotRestart",
        "title": "Flutter: Hot restart (vista previa en teléfono)"
      }
    ],
    "configuration": {
      "title": "Flutter Phone Preview",
      "properties": {
        "flutterPhonePreview.port": {
          "type": "number",
          "default": 5001,
          "description": "Puerto usado por 'flutter run -d web-server'."
        },
        "flutterPhonePreview.device": {
          "type": "string",
          "enum": ["iphone15", "iphone_16_pro_max", "iphone_14", "iphone_se", "pixel7", "pixel8", "galaxy_s22", "galaxy_s24_ultra", "galaxy_a54", "xiaomi_redmi_note13", "oneplus_12", "moto_edge", "ipad_mini", "ipad_pro"],
          "enumDescriptions": [
            "iPhone 15 Pro (con Dynamic Island)",
            "iPhone 16 Pro Max (pantalla grande, con Dynamic Island)",
            "iPhone 14 (con notch clásico)",
            "iPhone SE (con botón de inicio)",
            "Google Pixel 7 (cámara punch-hole)",
            "Google Pixel 8 (cámara punch-hole)",
            "Samsung Galaxy S22 (cámara punch-hole)",
            "Samsung Galaxy S24 Ultra (cámara punch-hole)",
            "Samsung Galaxy A54 (cámara punch-hole)",
            "Xiaomi Redmi Note 13 (cámara punch-hole)",
            "OnePlus 12 (cámara punch-hole)",
            "Motorola Edge 40 (cámara punch-hole)",
            "iPad Mini (tablet, sin notch)",
            "iPad Pro 11\" (tablet grande, sin notch)"
          ],
          "default": "iphone15",
          "description": "Modelo de teléfono mostrado inicialmente. También se puede cambiar desde el propio panel con el selector desplegable."
        },
        "flutterPhonePreview.autoReloadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Al guardar un archivo .dart, envía automáticamente un hot reload a Flutter y refresca el panel cuando termina de recompilar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
